#!/usr/bin/env bash
# Testeur des règles des sujets CPP (00 à 09). Ne juge pas la logique de tes exos.
#
#   cpptest              dans Module-0X/exYY -> cet exercice
#                        dans Module-0X      -> tout le module
#                        ailleurs            -> tous les modules
#   cpptest 02           tout le Module-02
#   cpptest 02 ex01      un seul exercice
#   cpptest -v ...       affiche aussi les détails des tests réussis

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$ROOT" ] || [ ! -f "$ROOT/tester/spec.txt" ]; then
	echo "Lance cpptest depuis l'intérieur du repo CPP-GANG."
	exit 1
fi
SPEC="$ROOT/tester/spec.txt"
CASES="$ROOT/tester/cases"

VERBOSE=0
[ "$1" = "-v" ] && { VERBOSE=1; shift; }

if [ -t 1 ]; then G=$'\e[32m'; R=$'\e[31m'; Y=$'\e[33m'; B=$'\e[1m'; D=$'\e[2m'; N=$'\e[0m'
else G=; R=; Y=; B=; D=; N=; fi

OKS=0; KOS=0; WARNS=0
ok()   { OKS=$((OKS+1)); if [ $VERBOSE = 1 ]; then echo "   ${G}OK${N}   $1"; fi; return 0; }
CUR=""; FIRST_KO=""; FIRST_HINT=""; FIRST_WARN=""
ko()   { KOS=$((KOS+1)); echo "   ${R}KO${N}   $1"; [ -n "$2" ] && echo "        ${D}→ $2${N}"
	if [ -z "$FIRST_KO" ]; then FIRST_KO="$CUR : $1"; FIRST_HINT="$2"; fi; return 0; }
warn() { WARNS=$((WARNS+1)); echo "   ${Y}WARN${N} $1"; [ -n "$2" ] && echo "        ${D}→ $2${N}"
	[ -z "$FIRST_WARN" ] && FIRST_WARN="$CUR : $1"; return 0; }

# --- Que tester ? ---
MOD=""; EX=""
if [ -n "$1" ]; then
	MOD="$(printf '%02d' "$((10#${1#Module-}))")"
	EX="$2"
else
	rel="${PWD#$ROOT}"
	case "$rel" in
		/Module-[0-9][0-9]*) MOD="${rel#/Module-}"; MOD="${MOD:0:2}"
			case "$rel" in /Module-[0-9][0-9]/ex[0-9][0-9]*) EX="${rel#/Module-??/}"; EX="${EX:0:4}";; esac;;
	esac
fi

# --- Helpers ---
srcfiles() { find . -maxdepth 1 -type f \( -name '*.cpp' -o -name '*.hpp' -o -name '*.h' -o -name '*.tpp' \) | sed 's|^\./||' | sort; }

# Code sans les commentaires (approximatif) pour éviter les faux positifs
strip_comments() { sed -e 's|//.*||' "$1" | awk 'BEGIN{c=0} { line=$0; out="";
	while (length(line)) { if (c) { i=index(line,"*/"); if (!i) { line=""; break } line=substr(line,i+2); c=0 }
		else { i=index(line,"/*"); if (!i) { out=out line; line=""; break } out=out substr(line,1,i-1); line=substr(line,i+2); c=1 } }
	print out }'; }

check_files() {
	local tok alt found f
	for tok in "$@"; do
		found=""
		IFS='|' read -ra alt <<< "$tok"
		for f in "${alt[@]}"; do
			if [[ "$f" == *"*"* ]]; then
				compgen -G "$f" > /dev/null && found="$f"
			elif [ -f "$f" ]; then found="$f"; fi
			[ -n "$found" ] && break
		done
		if [ -n "$found" ]; then ok "fichier $tok"
		else
			local lower="" a
			for a in "${alt[@]}"; do [[ "$a" == *"*"* ]] && continue; lower="$(ls 2>/dev/null | grep -ixF "$a" | head -1)"; [ -n "$lower" ] && break; done
			if [ -n "$lower" ]; then ko "fichier $tok absent (tu as « $lower » : la casse compte)" "renomme-le en gardant l'historique avec git mv, puis pense aux #include qui le citent"
			else ko "fichier $tok absent" "le sujet l'exige dans « Files to Submit » : même nom, même casse"; fi
		fi
	done
}

check_makefile() {
	[ -f Makefile ] || return 1
	local r
	for r in all clean fclean re; do
		grep -qE "^$r[[:space:]]*:" Makefile && ok "règle $r" || ko "règle « $r » absente du Makefile" "« make $r » doit exister : relis les règles Makefile de la Norme"
	done
	grep -qE '^\$\(NAME\)[[:space:]]*:' Makefile && ok "règle \$(NAME)" || ko "règle « \$(NAME): » absente du Makefile" "c'est la règle qui fabrique le binaire, et all doit en dépendre"
	for r in -Wall -Wextra -Werror -std=c++98; do
		grep -q -- "$r" Makefile && ok "flag $r" || ko "flag $r absent du Makefile" "ajoute-le dans CXXFLAGS"
	done
	grep -qE '^CXX[[:space:]]*:?=[[:space:]]*c\+\+' Makefile && ok "compilateur c++" \
		|| warn "le sujet demande de compiler avec c++" "CXX = c++"
}

check_build() {
	local name tmp out
	name="$(sed -n 's/^NAME[[:space:]]*:\{0,1\}=[[:space:]]*//p' Makefile | head -1 | tr -d '[:space:]')"
	[ -z "$name" ] && { ko "variable NAME introuvable dans le Makefile" "déclare NAME = <nom du binaire> en haut du Makefile"; return; }
	tmp="$(mktemp -d)"; cp -R . "$tmp/ex"
	(
		cd "$tmp/ex" || exit
		make fclean > /dev/null 2>&1
		if ! out="$(make 2>&1)"; then
			echo "$out" > "$tmp/err"; exit 3
		fi
		[ -x "$name" ] || exit 7
		out="$(make 2>&1)"
		if echo "$out" | grep -qE '(c\+\+|g\+\+|clang)'; then exit 4; fi
		make fclean > /dev/null 2>&1
		if [ -e "$name" ] || compgen -G '*.o' > /dev/null; then exit 5; fi
		make re > /dev/null 2>&1 && [ -x "$name" ] || exit 6
		exit 0
	)
	local rc=$? hint
	BIN=""
	case $rc in
		0) ok "compile, pas de relink, fclean et re OK"; BIN="$tmp/ex/$name";;
		3)	if grep -q "undefined reference to \`main'" "$tmp/err"; then hint="aucun fichier compilé ne contient main() : regarde ce que liste SRCS"
			elif grep -q "undefined reference" "$tmp/err"; then hint="une fonction est déclarée mais jamais compilée : un .cpp manque dans SRCS, ou elle n'est pas définie"
			elif grep -qiE "no such file|file not found" "$tmp/err"; then hint="un fichier est introuvable : vérifie le nom (et la casse) dans SRCS et dans tes #include"
			else hint="lis la première erreur, pas la dernière"; fi
			ko "compilation" "$hint"; head -12 "$tmp/err" | sed 's/^/        /';;
		7) ko "make ne produit pas « $name »" "NAME doit être exactement le fichier créé par -o";;
		4) ko "relink : un 2e « make » recompile" "si rien n'a changé, make ne doit rien refaire : regarde les dépendances de \$(NAME) et les règles qui touchent des fichiers";;
		5) ko "fclean laisse des fichiers" "fclean doit supprimer le binaire, et les .o via clean";;
		6) ko "make re échoue" "re = fclean puis all";;
	esac
	BUILD_TMP="$tmp"
}

check_forbidden() {
	local mod="$1" f code
	local -a extra=("${@:2}")
	for f in $(srcfiles); do
		code="$(strip_comments "$f")"
		echo "$code" | grep -qE '\b(printf|fprintf|sprintf|snprintf|dprintf|malloc|calloc|realloc|free)[[:space:]]*\(' \
			&& ko "$f : *printf / *alloc / free interdits (note 0)" "en C++ : std::cout pour afficher, new et delete pour la mémoire"
		echo "$code" | grep -qE '\busing[[:space:]]+namespace\b' && ko "$f : « using namespace » interdit (-42)" "écris std:: devant ce que tu utilises"
		echo "$code" | grep -qE '\bfriend\b' && ko "$f : « friend » interdit (-42)" "passe par l'interface publique de la classe (getters)"
		if [ "$((10#$mod))" -lt 8 ] && [ "$f" != tests.cpp ]; then
			echo "$code" | grep -qE '#[[:space:]]*include[[:space:]]*<(vector|list|map|set|deque|stack|queue|algorithm|unordered_map|unordered_set|bitset|forward_list|array)>' \
				&& ko "$f : STL (conteneurs / <algorithm>) interdite avant le Module 08 (-42)" "tableau classique ou ta propre structure"
		fi
		local p
		for p in "${extra[@]}"; do
			[ -n "$p" ] && echo "$code" | grep -qE "$p" && ko "$f : interdit par le sujet ($p)" "relis la ligne « Forbidden » de l'exercice : c'est justement ce qu'il veut te faire faire autrement"
		done
	done
	ok "fonctions et mots-clés interdits"
}

check_headers() {
	local mod="$1" h
	for h in $(ls *.hpp *.h 2>/dev/null); do
		if grep -qE '^[[:space:]]*#[[:space:]]*ifndef' "$h" && grep -qE '^[[:space:]]*#[[:space:]]*define' "$h"; then ok "$h : include guard"
		elif grep -q '#pragma once' "$h"; then warn "$h : #pragma once n'est pas standard" "le sujet demande des include guards (#ifndef / #define)"
		else ko "$h : pas d'include guard (note 0)" "#ifndef / #define en haut, #endif en bas"; fi
		if printf '#include "%s"\n' "$h" | c++ -std=c++98 -Wall -Wextra -Werror -fsyntax-only -x c++ - 2>/dev/null; then
			ok "$h : compile seul"
		else ko "$h : ne compile pas seul" "ajoute dans ce header les #include dont il a besoin lui-même"; fi
		if ! grep -q 'template' "$h" && strip_comments "$h" | grep -qE '\)[[:space:]]*(const)?[[:space:]]*\{'; then
			warn "$h : semble contenir un corps de fonction" "si ce n'est pas un template, déplace l'implémentation dans le .cpp (sinon 0)"
		fi
		if [ "$((10#$mod))" -ge 2 ]; then
			local cls
			for cls in $(strip_comments "$h" | sed -nE 's/^[[:space:]]*class[[:space:]]+([A-Za-z_][A-Za-z0-9_]*)[^;]*$/\1/p'); do
				local code miss=""
				code="$(strip_comments "$h" | tr -d '\n')"
				echo "$code" | grep -qE "\b$cls[[:space:]]*\([[:space:]]*(void)?[[:space:]]*\)" || miss="$miss constructeur-par-défaut"
				echo "$code" | grep -qE "\b$cls[[:space:]]*\([[:space:]]*(const[[:space:]]+$cls|$cls[[:space:]]+const)[[:space:]]*&" || miss="$miss constructeur-de-copie"
				echo "$code" | grep -qE "operator[[:space:]]*=[[:space:]]*\(" || miss="$miss operator="
				echo "$code" | grep -qE "~$cls[[:space:]]*\(" || miss="$miss destructeur"
				[ -n "$miss" ] && warn "$h : $cls pas en forme canonique ? manque :$miss" "à partir du 02 : constructeur par défaut, de copie, operator= et destructeur"
			done
		fi
	done
}

# Tests d'exécution (tester/cases/Module-XX/exYY/) :
#   NN.args   arguments, un par ligne (absent ou vide = aucun)
#   NN.gen    script qui affiche les arguments (ex : 3000 nombres aléatoires)
#   NN.out    sortie attendue (stdout + stderr)
#   NN.keep   regex : ne compare que les lignes qui correspondent
#   NN.ignore regex : ignore les lignes qui correspondent
#   NN.check  script de vérif (reçoit la sortie sur stdin, les args en paramètres) à la place de NN.out
#   NN.dir/   fichiers copiés à côté du binaire avant l'exécution
#   NN.needs  fichier qui doit être présent dans ton exercice (sinon le cas est ignoré)
#   subject_main.cpp : main fourni par le sujet, compilé avec TES autres .cpp à la place de ton main
filter_lines() { # $1 = fichier keep, $2 = fichier ignore
	local in; in="$(cat)"
	[ -f "$1" ] && in="$(printf '%s\n' "$in" | grep -E "$(cat "$1")")"
	[ -f "$2" ] && in="$(printf '%s\n' "$in" | grep -vE "$(cat "$2")")"
	printf '%s\n' "$in" | sed -e 's/[[:space:]]*$//' -e '/^$/d'
}

check_cases() {
	local dir="$CASES/Module-$1/$2" c base args exp got bin="$BIN" rundir label
	[ -d "$dir" ] || return
	if [ -f "$dir/subject_main.cpp" ]; then
		[ -z "$BIN" ] && { warn "tests d'exécution ignorés (ton exercice ne compile pas)"; return; }
		local sm="$BUILD_TMP/subject"; mkdir -p "$sm"; cp ./*.cpp ./*.hpp ./*.h ./*.tpp "$sm"/ 2>/dev/null
		rm -f "$sm/main.cpp"; cp "$dir/subject_main.cpp" "$sm/"
		local h; for h in "$sm"/*.h; do [ -e "$h" ] || continue; h="$(basename "${h%.h}")"
			sed -i.bak "s|\"$h.hpp\"|\"$h.h\"|" "$sm/subject_main.cpp"; done
		if ! c++ -Wall -Wextra -Werror -std=c++98 "$sm"/*.cpp -o "$sm/subject_bin" 2> "$sm/err"; then
			ko "ne compile pas avec le main du sujet" "vérifie les noms et signatures exactes demandées par le sujet"
			head -8 "$sm/err" | sed 's/^/        /'; return
		fi
		bin="$sm/subject_bin"; label=" (main du sujet)"
	fi
	[ -z "$bin" ] && { warn "tests d'exécution ignorés (pas de binaire)"; return; }
	for c in "$dir"/*.out "$dir"/*.check; do
		[ -e "$c" ] || continue
		base="${c%.*}"
		[[ "$c" == *.out && -e "$base.check" ]] && continue
		if [ -f "$base.needs" ] && [ ! -e "$(cat "$base.needs")" ]; then
			warn "test $(basename "$base") ignoré : il faut $(cat "$base.needs") dans ton exercice" "le sujet le fournit en téléchargement"; continue
		fi
		args=()
		[ -f "$base.args" ] && mapfile -t args < "$base.args"
		[ -f "$base.gen" ] && mapfile -t args < <(bash "$base.gen")
		rundir="$(dirname "$bin")"
		[ -d "$base.dir" ] && cp -R "$base.dir"/. "$rundir"/
		cp ./*.csv ./*.txt "$rundir"/ 2>/dev/null
		got="$(cd "$rundir" && timeout 10 "$bin" "${args[@]}" 2>&1)"
		local shown="${args[*]}"; [ ${#shown} -gt 40 ] && shown="${#args[@]} arguments"
		if [[ "$c" == *.check ]]; then
			local why
			if why="$(printf '%s\n' "$got" | bash "$c" "${args[@]}" 2>&1)"; then ok "exécution $(basename "$base")$label"
			else ko "exécution $(basename "$base")$label${shown:+ : args [$shown]}" "$why"
				printf '%s\n' "$got" | head -4 | cut -c1-100 | sed 's/^/        obtenu : /'; fi
		else
			exp="$(filter_lines "$base.keep" "$base.ignore" < "$c")"
			got="$(printf '%s\n' "$got" | filter_lines "$base.keep" "$base.ignore")"
			if [ "$got" = "$exp" ]; then ok "exécution $(basename "$base")$label"
			else
				ko "exécution $(basename "$base")$label${shown:+ : args [$shown]}" "compare ligne par ligne avec l'exemple du sujet"
				diff <(printf '%s\n' "$exp") <(printf '%s\n' "$got") | grep '^[<>]' | head -6 \
					| sed -e 's/^</        attendu :/' -e 's/^>/        obtenu  :/'
			fi
		fi
		if command -v valgrind > /dev/null; then
			(cd "$rundir" && timeout 60 valgrind -q --leak-check=full --error-exitcode=42 "$bin" "${args[@]}" > /dev/null 2>&1)
			[ $? = 42 ] && ko "fuites ou erreurs mémoire (valgrind) avec [$shown]" "chaque new a-t-il son delete ?"
		fi
	done
}

test_ex() {
	local mod="$1" ex="$2"; shift 2
	local files=("$@")
	local dir="$ROOT/Module-$mod/$ex"
	CUR="Module-$mod/$ex"
	if [ ! -d "$dir" ]; then echo " ${D}$CUR : pas commencé${N}"; STATUS["$mod $ex"]=absent; return; fi
	echo "${B}Module-$mod/$ex${N}"
	local k0=$KOS
	BIN=""; BUILD_TMP=""
	pushd "$dir" > /dev/null || return
	local -a forb=()
	while read -r _ m e p; do forb+=("$p"); done < <(grep -E "^forbid $mod $ex " "$SPEC")
	check_files "${files[@]}"
	check_makefile && check_build
	check_forbidden "$mod" "${forb[@]}"
	check_headers "$mod"
	check_cases "$mod" "$ex"
	popd > /dev/null || return
	[ -n "$BUILD_TMP" ] && rm -rf "$BUILD_TMP"
	if [ $KOS = "$k0" ]; then echo "   ${G}✓ conforme${N}"; STATUS["$mod $ex"]=ok; else STATUS["$mod $ex"]=ko; fi
}

# --- Boucle principale ---
FOUND=0
declare -A STATUS
ORDER=()
while read -r mod ex rest; do
	case "$mod" in ''|'#'*|forbid) continue;; esac
	[ -n "$MOD" ] && [ "$mod" != "$MOD" ] && continue
	[ -n "$EX" ] && [ "$ex" != "$EX" ] && continue
	FOUND=1
	ORDER+=("$mod $ex")
	read -ra files <<< "$rest"
	test_ex "$mod" "$ex" "${files[@]}"
done < "$SPEC"

[ $FOUND = 0 ] && { echo "Rien à tester pour « Module-$MOD ${EX} »."; exit 1; }
command -v valgrind > /dev/null || echo "${D}(valgrind absent : pas de test de fuites. Fais-le au cluster.)${N}"
echo
echo "${B}Bilan :${N} ${R}$KOS KO${N}, ${Y}$WARNS WARN${N}$([ $VERBOSE = 1 ] && echo ", ${G}$OKS OK${N}")"

# --- Prochaine étape ---
next_in_module() { # exercice suivant dans le spec, même module
	grep -E "^$1 ex[0-9]{2} " "$SPEC" | awk -v e="$2" 'f{print $2; exit} $2==e{f=1}'
}
echo
if [ -n "$FIRST_KO" ]; then
	echo "${B}Prochaine étape :${N} corriger $FIRST_KO"
	[ -n "$FIRST_HINT" ] && echo "   ${D}→ $FIRST_HINT${N}"
	[ $KOS -gt 1 ] && echo "   ${D}puis relance cpptest pour la suite ($KOS KO en tout)${N}"
else
	todo=""
	for k in "${ORDER[@]}"; do [ "${STATUS[$k]}" = absent ] && { todo="$k"; break; }; done
	if [ -n "$EX" ]; then
		nx="$(next_in_module "$MOD" "$EX")"
		if [ -z "$nx" ]; then
			echo "${B}Prochaine étape :${N} dernier exercice du module. Vérifie tout le module avec « cpptest $MOD », puis rends-le avec ./vog.sh Module-$MOD <url>"
		elif [ -d "$ROOT/Module-$MOD/$nx" ]; then
			echo "${B}Prochaine étape :${N} Module-$MOD/$nx existe déjà : « cd ../$nx && cpptest »"
		else
			echo "${B}Prochaine étape :${N} attaquer Module-$MOD/$nx : « mkdir ../$nx », et relis son sujet en entier avant de coder"
		fi
	elif [ -n "$todo" ]; then
		set -- $todo
		echo "${B}Prochaine étape :${N} attaquer Module-$1/$2 (relis son sujet en entier avant de coder)"
	elif [ -n "$MOD" ]; then
		echo "${B}Prochaine étape :${N} Module-$MOD complet et conforme. Teste les fuites au cluster (valgrind), puis : ./vog.sh Module-$MOD <url>"
	else
		echo "${B}Prochaine étape :${N} tout est conforme. Bravo."
	fi
	[ -n "$FIRST_WARN" ] && echo "   ${D}avant de rendre, jette un œil aux WARN (ex : $FIRST_WARN)${N}"
fi
[ $KOS = 0 ]
